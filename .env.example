DATABASE_URL=mysql://user:password@localhost:3306/horizon
JWT_SECRET=change-this-secret-in-production
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=4000

# Origines autorisées par CORS, séparées par des virgules.
# Laisser vide en dev local pour autoriser tout (un warning sera loggé).
# En prod : CORS_ALLOWED_ORIGINS=https://horizonmoto.fr,https://admin.horizonmoto.fr
CORS_ALLOWED_ORIGINS=

# SMTP — utilisé pour envoyer les codes de réinitialisation de mot de passe.
# Si les variables SMTP_* sont absentes ou vides, le code est juste loggé dans
# la console (mode mock, pratique pour le dev).
#
# Hostinger : smtp.hostinger.com / 587 (STARTTLS) / login = adresse mail complète.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
